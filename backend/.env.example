# Softoria Technologies - Backend Environment Configuration

# Server Port (defaults to 5000 if omitted)
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster_host>/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.1nmhply.mongodb.net/softoria_technologies?retryWrites=true&w=majority

# JWT Secret for Admin Session Signing (generate a strong random 64-char string)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_for_production

# Frontend Client URL for CORS (defaults to http://localhost:5173 if omitted)
FRONTEND_URL=http://localhost:5173

# Initial Admin Seeding Configuration (used by scripts/seedAdmin.js)
ADMIN_INITIAL_USERNAME=softoria_admin
ADMIN_INITIAL_EMAIL=admin@softoria.com
ADMIN_INITIAL_PASSWORD=your_initial_secure_admin_password_here
